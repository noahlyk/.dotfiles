#!/usr/bin/env bash
# Wrapper used by the Sober .desktop entry (Exec= can't do shell constructs).
# Routes every launch -- app menu, roblox:// links from the browser -- through
# gamelaunch's sober preset so it gets MangoHud, the CCD pin, the fps patch
# and the right Wayland/gamescope mode. Extra args (the roblox:// URL) are
# forwarded to Sober.
set -euo pipefail

exec "$(dirname "$(readlink -f "$0")")/gamelaunch" --preconfig sober -- org.vinegarhq.Sober "$@"

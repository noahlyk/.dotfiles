#!/usr/bin/env bash
# Alt+a: next Claude worth looking at. All logic lives in claude-sessions (see its header for the tiers).
# Usage: claude-next CURRENT_PANE_ID CLIENT_NAME | claude-next --peek CURRENT_PANE_ID
here=$(dirname "$(readlink -f "$0")")
if [[ ${1:-} == --peek ]]; then exec "$here/claude-sessions" peek "${2:-}"; fi
exec "$here/claude-sessions" next "${1:-}" "${2:-}"

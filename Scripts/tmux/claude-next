#!/usr/bin/env bash
# Alt+a: take me to the next Claude that is worth looking at. Each press walks one cycle, and when a
# cycle has nothing left (other than where you already are) it falls through to the next one:
#
#   1. needs you   waiting (permission prompt / question) first, longest wait first; then finished
#   2. idle        Claude is open and ready for your next prompt, in session/window order
#   3. working     still running, in session/window order (check on it)
#   4. closed      a recent chat whose project has no Claude open: reopen its tmux session
#                  and `claude --resume` it, exactly where it left off (see claude-chats)
#
# Within a cycle, pressing again moves to the next pane after the one you are on and wraps round;
# several chats in one session are separate stops. Two chats in the same pane (/resume inside one
# claude) are invisible from outside tmux, so those are not told apart.
# Usage: claude-next CURRENT_PANE_ID CLIENT_NAME
#        claude-next --peek CURRENT_PANE_ID   name of the pane cycle 1 would jump to (the status pill)
set -uo pipefail

script_dir=$(dirname "$(readlink -f "$0")")
field_separator=$'\x1f'

# tier US sub US order US window US pane US pane_id, already sorted. Tier 1 orders by how long the
# state has lasted (zero-padded so text sort works); tiers 2 and 3 by session name, window, pane.
ranked_claude_panes() {
  tmux list-panes -a -F "#{@claude_state}${field_separator}#{@claude_state_since}${field_separator}#{pane_id}${field_separator}#{pane_current_command}${field_separator}#{session_name}${field_separator}#{window_index}${field_separator}#{pane_index}" |
    awk -F "$field_separator" -v OFS="$field_separator" '
      $1 == "waiting" { printf "1%s0%s%012d%s0%s0%s%s\n", OFS, OFS, $2 + 0, OFS, OFS, OFS, $3; next }
      $1 == "done"    { printf "1%s1%s%012d%s0%s0%s%s\n", OFS, OFS, $2 + 0, OFS, OFS, OFS, $3; next }
      $1 == "" && $4 != "claude" { next }
      $1 == "working" { print 3, 0, $5, $6, $7, $3; next }
      { print 2, 0, $5, $6, $7, $3 }' |
    sort -t "$field_separator" -k1,1n -k2,2n -k3,3 -k4,4n -k5,5n
}

# Names the pane Alt+a jumps to, same as its tab and the Alt+g dashboard: the Claude title cut at a
# word boundary to 20 characters; the project when it has no name yet.
pane_display_name() {
  local title session_name
  title=$(tmux display -p -t "$1" '#{E:@claude_title_full}')
  if [[ -z $title || $title == "Claude Code" ]]; then
    session_name=$(tmux display -p -t "$1" '#{session_name}')
    echo "${session_name##*/}"
    return
  fi
  if (( ${#title} > 20 )); then
    title=${title:0:21}
    [[ $title == *" "* ]] && title=${title% *}
  fi
  echo "${title:0:20}"
}

# The panes of one tier after CURRENT, wrapping, without CURRENT itself. Prints nothing if none.
cycle_of_tier() {
  local tier=$1 current=$2 line pane_id seen_current=false
  local -a before=() after=()
  while IFS= read -r line; do
    [[ ${line%%"$field_separator"*} == "$tier" ]] || continue
    pane_id=${line##*"$field_separator"}
    if [[ $pane_id == "$current" ]]; then seen_current=true
    elif $seen_current; then after+=("$pane_id")
    else before+=("$pane_id"); fi
  done <<<"$ranked"
  printf '%s\n' "${after[@]}" "${before[@]}" | awk 'NF'
}

ranked=$(ranked_claude_panes)

if [[ ${1:-} == --peek ]]; then
  target=$(cycle_of_tier 1 "${2:-}" | head -1)
  [[ -n $target ]] && pane_display_name "$target"
  exit 0
fi

current_pane=$1
client_name=$2

announce() { tmux display-message -c "$client_name" "$1"; }

for tier in 1 2 3; do
  target=$(cycle_of_tier "$tier" "$current_pane" | head -1)
  [[ -n $target ]] || continue
  "$script_dir/claude-focus-pane" "$target" "$client_name"
  case $tier in
    2) announce "Alt+a · idle chat: $(pane_display_name "$target")" ;;
    3) announce "Alt+a · still working: $(pane_display_name "$target")" ;;
  esac
  exit 0
done

# Nothing else is open: bring back the most recent closed chat, if reopening is allowed.
if [[ $(tmux show -gqv @claude_next_reopen) != off ]]; then
  IFS=$field_separator read -r _ session_id project_dir prompt < <("$script_dir/claude-chats" closed | head -1)
  if [[ -n ${session_id:-} ]]; then
    "$script_dir/claude-chats" reopen "$session_id" "$client_name" &&
      announce "Alt+a · resumed ${project_dir##*/}: ${prompt:0:60}"
    exit 0
  fi
fi
announce "Alt+a · nothing needs you and no recent chat to resume"

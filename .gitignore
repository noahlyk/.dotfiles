gpg_key.asc
.password-store/


# Screenshots
Pictures/Screenshots/

# Game save files that change on every play session
*.sav

# Wine/Proton prefixes (compatdata) — regenerating runtime state, keep config out
.local/share/Steam/steamapps/compatdata/*/pfx/

# Moved runtime/state data
.local/share/cargo/
.local/share/rustup/
.local/share/pki/
.local/share/vim/
.local/state/
.cache/nv/

# Flatpak app state (regenerated by the app itself)
.var/app/

# tmux-leap recall list -- mutates on every use
.config/tmux-leap/.projects_cache

# Node.js artifacts (global)
node_modules/
package-lock.json


# KDE session autosave state
.config/session/

# Claude Code worktrees
.claude/worktrees/

# Python bytecode cache
__pycache__/
*.pyc

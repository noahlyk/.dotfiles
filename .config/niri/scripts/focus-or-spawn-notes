#!/bin/bash
# Focus the Notes nvim window if it exists, otherwise spawn it.
# Usage: focus-or-spawn-notes
TITLE="Notes nvim"

wid=$(niri msg --json windows | jq --arg title "$TITLE" -r \
  '[.[] | select(.title == $title)] | .[0].id // empty')

if [ -n "$wid" ]; then
  niri msg action focus-window --id "$wid"
else
  setsid kitty -o background="#000000" -o background_opacity="1" -o font_size=36 sh -c 'nvim -u ~/.config/nvim/notepad.vim /tmp/notes.md' &
  pid=$!

  while :; do
    wid=$(niri msg --json windows | jq --argjson pid "$pid" -r \
      '[.[] | select(.pid == $pid)] | .[0].id // empty')
    [ -n "$wid" ] && break
    sleep 0.05
  done

  niri msg action toggle-windowed-fullscreen --id "$wid"
fi

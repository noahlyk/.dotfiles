layout {
    background-color "transparent"
    center-focused-column "never"
    default-column-display "normal"
    always-center-single-column
    preset-column-widths {
        proportion 0.25
        proportion 0.50
        proportion 0.75
        proportion 0.97
    }
    default-column-width { proportion 0.97; }
    preset-window-heights {
        proportion 0.25
        proportion 0.50
        proportion 0.75
    }
    // vertical tab bar unused; Mod+W tabbed mode still works without it
    tab-indicator { off; }
    border {
        // active-color   "#cc4444"      // Softer red
        active-color   "#808080f5"      // Neutral gray
        inactive-color "#00000090"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }
    focus-ring {
        off
        active-color   "#808080f5"      // Medium gray
        inactive-color "#50505000"      // Dark gray
    }
    shadow {
        on
        softness 10
        spread 3
        offset x=0 y=0
        draw-behind-window false
        color "#00000070"
        inactive-color "#00000000"
    }
}



config-notification {
    disable-failed
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 200
        repeat-rate 70
        numlock
    }
    touchpad {
        tap
    }
    mouse {
        accel-profile "flat"
        accel-speed 0.6
    }
    warp-mouse-to-focus
    mod-key "Super"
}

workspace "mon1-1" {
    open-on-output "DP-1"
}
workspace "mon1-2" {
    open-on-output "DP-1"
}
workspace "mon1-3" {
    open-on-output "DP-1"
}
workspace "mon1-4" {
    open-on-output "DP-1"
}
workspace "mon1-5" {
    open-on-output "DP-1"
}
workspace "mon1-6" {
    open-on-output "DP-1"
}
workspace "mon1-7" {
    open-on-output "DP-1"
}
workspace "mon2-1" {
    open-on-output "DP-2"
}
workspace "mon3-1" {
    open-on-output "HDMI-A-1"
}
workspace "mon3-2" {
    open-on-output "HDMI-A-1"
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}



overview {
    zoom 0.25
}

// dms already registers its own polkit authentication agent at session
// start; a separate mate-polkit agent errors "already exists" and is a no-op.
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
// Each lands on its workspace via open-on-workspace rules in custom-overrides.kdl;
// focus-on-open.sh then focuses firefox/keepassxc/kitty/obs when they open
spawn-at-startup "vesktop"
spawn-at-startup "steam" "-silent"
spawn-at-startup "firefox"
spawn-at-startup "bash" "-c" "$HOME/.config/niri/scripts/focus-on-open.sh"
environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORMTHEME "qt6ct"
  QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
  TERMINAL "kitty"
}
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
  off
  slowdown 0.5
  workspace-switch {
    duration-ms 50
    curve "cubic-bezier" 0.16 1 0.3 1
  }
  window-open {
    duration-ms 120
    curve "cubic-bezier" 0.34 1.4 0.64 1
  }
  window-close {
    duration-ms 100
    curve "cubic-bezier" 0.33 0 0.67 0
  }
  horizontal-view-movement {
    duration-ms 50
    curve "cubic-bezier" 0.16 1 0.3 1
  }
  window-movement {
    duration-ms 120
    curve "cubic-bezier" 0.22 1 0.36 1
  }
  config-notification-open-close {
    duration-ms 100
    curve "cubic-bezier" 0.22 1 0.36 1
  }
  screenshot-ui-open {
    duration-ms 120
    curve "cubic-bezier" 0.22 1 0.36 1
  }
  overview-open-close {
    duration-ms 200
    curve "cubic-bezier" 0.34 1.2 0.64 1
  }
}

binds {
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Shift+F12 hotkey-overlay-title="OBS Save Replay" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/obs_ws.py replay"
    }

    // MouseRight {
    //     spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/obs_ws.py toggle-recording-with-music"
    // }

    // wayscriber one-shot: no standby daemon. Home click-picks a monitor
    // (via an invisible slurp point-select) and opens the overlay there.
    // Pressing Home again closes it; pressing Home while the monitor-pick
    // is still waiting for a click cancels the pick instead of opening.
    // Once open, wayscriber grabs the keyboard itself, so undo/clear/color/
    // etc. all work via its own shortcuts (Ctrl+Z, E, Escape) with no extra
    // binds needed here. See ~/.config/niri/scripts/wayscriber-toggle.sh.
    Home hotkey-overlay-title="Wayscriber Draw Overlay" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/wayscriber-toggle.sh"; }


    Mod+T hotkey-overlay-title="Open Terminal" {
        spawn "kitty" "sh" "-c" "tmux-leap goto ~" // || tmux new -A || tmux a || tmux"
    }
    Mod+Shift+C hotkey-overlay-title="Open Odds Calculator" {
        spawn "kitty" "sh" "-c" "cd ~/code/fibsussy/odds && exec $HOME/.local/bin/uv run python launch.py"
    }
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "toggle";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "dms" "ipc" "call" "settings" "toggle";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "dms" "ipc" "call" "dankdash" "wallpaper";
    }
    Mod+D hotkey-overlay-title="Download Clipboard URL" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/download.sh --temp --notify";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "dms" "ipc" "call" "notifications" "toggle";
    }
    Mod+E hotkey-overlay-title="File Manager" {
        spawn "dolphin";
    }
    Mod+Shift+N hotkey-overlay-title="Notepad" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/focus-or-spawn-notes"
    }
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "dms" "ipc" "call" "lock" "lock";
    }
    Ctrl+Alt+Backspace hotkey-overlay-title="Power Menu" {
        spawn "dms" "ipc" "call" "powermenu" "toggle";
    }
    Ctrl+Alt+Escape hotkey-overlay-title="System Monitor (btop)" {
        spawn "kitty" "sh" "-c" "btop"
    }

    Ctrl+Alt+Delete { quit; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Shift+F hotkey-overlay-title="Windowed Fullscreen" { toggle-windowed-fullscreen; }
    Mod+Shift+T hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Ctrl+Shift+T hotkey-overlay-title="Switch Floating/Tiling Focus" { switch-focus-between-floating-and-tiling; }
    Mod+W hotkey-overlay-title="Toggle Tabbed Column" { toggle-column-tabbed-display; }

    Mod+Left hotkey-overlay-title="Focus Left" { focus-column-or-monitor-left; }
    Mod+Down hotkey-overlay-title="Focus Down" { focus-window-or-monitor-down; }
    Mod+Up hotkey-overlay-title="Focus Up" { focus-window-or-monitor-up; }
    Mod+Right hotkey-overlay-title="Focus Right" { focus-column-or-monitor-right; }
    Mod+H hotkey-overlay-title="Focus Left" { focus-column-or-monitor-left; }
    Mod+J hotkey-overlay-title="Focus Down" { focus-window-or-monitor-down; }
    Mod+K hotkey-overlay-title="Focus Up" { focus-window-or-monitor-up; }
    Mod+L hotkey-overlay-title="Focus Right" { focus-column-or-monitor-right; }

    Mod+Shift+Left hotkey-overlay-title="Move Left" { move-column-left; }
    Mod+Shift+Down hotkey-overlay-title="Move Down" { move-window-down; }
    Mod+Shift+Up hotkey-overlay-title="Move Up" { move-window-up; }
    Mod+Shift+Right hotkey-overlay-title="Move Right" { move-column-right; }
    Mod+Shift+H hotkey-overlay-title="Move Left" { move-column-left; }
    Mod+Shift+J hotkey-overlay-title="Move Down" { move-window-down; }
    Mod+Shift+K hotkey-overlay-title="Move Up" { move-window-up; }
    Mod+Shift+L hotkey-overlay-title="Move Right" { move-column-right; }

    Mod+Home hotkey-overlay-title="Focus First Column" { focus-column-first; }
    Mod+End hotkey-overlay-title="Focus Last Column" { focus-column-last; }
    Mod+Ctrl+Home hotkey-overlay-title="Move Column to First" { move-column-to-first; }
    Mod+Ctrl+End hotkey-overlay-title="Move Column to Last" { move-column-to-last; }

    Mod+Ctrl+Left hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Ctrl+Down hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Ctrl+Up hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }
    Mod+Ctrl+H hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Ctrl+J hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Ctrl+K hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Ctrl+L hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }

    Mod+Shift+Ctrl+Left hotkey-overlay-title="Move Column to Monitor Left" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down hotkey-overlay-title="Move Column to Monitor Down" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up hotkey-overlay-title="Move Column to Monitor Up" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right hotkey-overlay-title="Move Column to Monitor Right" { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H hotkey-overlay-title="Move Column to Monitor Left" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J hotkey-overlay-title="Move Column to Monitor Down" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K hotkey-overlay-title="Move Column to Monitor Up" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L hotkey-overlay-title="Move Column to Monitor Right" { move-column-to-monitor-right; }

    Mod+Page_Down hotkey-overlay-title="Next Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next focus"; }
    Mod+Page_Up hotkey-overlay-title="Previous Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev focus"; }
    Mod+U hotkey-overlay-title="Next Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next focus"; }
    Mod+I hotkey-overlay-title="Previous Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev focus"; }
    Mod+Shift+Ctrl+U hotkey-overlay-title="Move Column to Next Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Shift+Ctrl+I hotkey-overlay-title="Move Column to Previous Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }

    Mod+Shift+Page_Down hotkey-overlay-title="Move Column to Next Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Shift+Page_Up hotkey-overlay-title="Move Column to Previous Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }
    Mod+Shift+U hotkey-overlay-title="Move Column to Next Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Shift+I hotkey-overlay-title="Move Column to Previous Workspace" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }

    Mod+WheelScrollDown      cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next focus"; }
    Mod+WheelScrollUp        cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev focus"; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }

    Mod+WheelScrollRight      { focus-column-right-or-first; }
    Mod+WheelScrollLeft       { focus-column-left-or-last; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right-or-first; }
    Mod+Shift+WheelScrollUp        { focus-column-left-or-last; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 hotkey-overlay-title="Go to Workspace mon1-1" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-1 smart"; }
    Mod+2 hotkey-overlay-title="Go to Workspace mon2-1" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon2-1 smart"; }
    Mod+3 hotkey-overlay-title="Go to Workspace mon3-1" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon3-1 smart"; }
    Mod+4 hotkey-overlay-title="Go to Workspace mon1-2" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-2"; }
    Mod+5 hotkey-overlay-title="Go to Workspace mon1-3" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-3"; }
    Mod+6 hotkey-overlay-title="Go to Workspace mon1-4" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-4"; }
    Mod+7 hotkey-overlay-title="Go to Workspace mon1-5" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-5"; }
    Mod+8 hotkey-overlay-title="Go to Workspace mon1-6" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-6"; }
    Mod+9 hotkey-overlay-title="Go to Workspace mon1-7" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-7"; }
    Mod+0 hotkey-overlay-title="Go to Workspace mon3-2" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh focus mon3-2"; }

    Mod+Return hotkey-overlay-title="Master Column Toggle" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-toggle.sh"
    }
    Mod+Grave hotkey-overlay-title="Master Column Toggle" {
        spawn-sh "$HOME/.config/niri/scripts/niri-column-toggle.sh"
    }

    Mod+Shift+1 hotkey-overlay-title="Move Column to Workspace mon1-1" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-1"; }
    Mod+Shift+2 hotkey-overlay-title="Move Column to Workspace mon2-1" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon2-1"; }
    Mod+Shift+3 hotkey-overlay-title="Move Column to Workspace mon3-1" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon3-1"; }
    Mod+Shift+4 hotkey-overlay-title="Move Column to Workspace mon1-2" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-2"; }
    Mod+Shift+5 hotkey-overlay-title="Move Column to Workspace mon1-3" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-3"; }
    Mod+Shift+6 hotkey-overlay-title="Move Column to Workspace mon1-4" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-4"; }
    Mod+Shift+7 hotkey-overlay-title="Move Column to Workspace mon1-5" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-5"; }
    Mod+Shift+8 hotkey-overlay-title="Move Column to Workspace mon1-6" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-6"; }
    Mod+Shift+9 hotkey-overlay-title="Move Column to Workspace mon1-7" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-7"; }
    Mod+Shift+0 hotkey-overlay-title="Move Column to Workspace mon3-2" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-workspace-go.sh move mon3-2"; }

    Mod+Ctrl+1 hotkey-overlay-title="Promote Column 1 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 1"; }
    Mod+Ctrl+2 hotkey-overlay-title="Promote Column 2 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 2"; }
    Mod+Ctrl+3 hotkey-overlay-title="Promote Column 3 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 3"; }
    Mod+Ctrl+4 hotkey-overlay-title="Promote Column 4 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 4"; }
    Mod+Ctrl+5 hotkey-overlay-title="Promote Column 5 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 5"; }
    Mod+Ctrl+6 hotkey-overlay-title="Promote Column 6 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 6"; }
    Mod+Ctrl+7 hotkey-overlay-title="Promote Column 7 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 7"; }
    Mod+Ctrl+8 hotkey-overlay-title="Promote Column 8 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 8"; }
    Mod+Ctrl+9 hotkey-overlay-title="Promote Column 9 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 9"; }
    Mod+Ctrl+0 hotkey-overlay-title="Promote Column 10 to Master" { spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-column-move.sh 10"; }

    Mod+Ctrl+Shift+1 hotkey-overlay-title="Move Column to Index 1" { move-column-to-index 1; }
    Mod+Ctrl+Shift+2 hotkey-overlay-title="Move Column to Index 2" { move-column-to-index 2; }
    Mod+Ctrl+Shift+3 hotkey-overlay-title="Move Column to Index 3" { move-column-to-index 3; }
    Mod+Ctrl+Shift+4 hotkey-overlay-title="Move Column to Index 4" { move-column-to-index 4; }
    Mod+Ctrl+Shift+5 hotkey-overlay-title="Move Column to Index 5" { move-column-to-index 5; }
    Mod+Ctrl+Shift+6 hotkey-overlay-title="Move Column to Index 6" { move-column-to-index 6; }
    Mod+Ctrl+Shift+7 hotkey-overlay-title="Move Column to Index 7" { move-column-to-index 7; }
    Mod+Ctrl+Shift+8 hotkey-overlay-title="Move Column to Index 8" { move-column-to-index 8; }
    Mod+Ctrl+Shift+9 hotkey-overlay-title="Move Column to Index 9" { move-column-to-index 9; }
    Mod+Ctrl+Shift+0 hotkey-overlay-title="Move Column to Index 10" { move-column-to-index 10; }

    Mod+BracketLeft hotkey-overlay-title="Consume/Expel Window Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume/Expel Window Right" { consume-or-expel-window-right; }
    Mod+Period hotkey-overlay-title="Expel Window From Column" { expel-window-from-column; }

    Mod+R hotkey-overlay-title="Cycle Width Preset" { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Cycle Width Preset Back" { switch-preset-column-width-back; }
    Mod+Ctrl+R hotkey-overlay-title="Reset Window Height" { reset-window-height; }
    Mod+Alt+R hotkey-overlay-title="Cycle Window Height Preset" { switch-preset-window-height; }
    Mod+Ctrl+F hotkey-overlay-title="Expand Column to Available Width" { expand-column-to-available-width; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center Visible Columns" { center-visible-columns; }

    Mod+Minus hotkey-overlay-title="Column Narrower" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Column Wider" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Window Shorter" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Window Taller" { set-window-height "+10%"; }

    XF86Launch1 hotkey-overlay-title="Screenshot (select)" { screenshot; }
    Ctrl+XF86Launch1 hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Alt+XF86Launch1 hotkey-overlay-title="Screenshot Window" { screenshot-window; }
    Print hotkey-overlay-title="Screenshot + Annotate" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh sh -c 'tmp=$(mktemp /tmp/screenshot.XXXXXX.png); niri msg action screenshot -p false --path \"$tmp\"; while [ ! -s \"$tmp\" ]; do sleep 0.05; done; satty --filename \"$tmp\"; rm -- \"$tmp\"'"
    }
    Ctrl+Print hotkey-overlay-title="Screenshot Screen + Annotate" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh sh -c 'tmp=$(mktemp /tmp/screenshot.XXXXXX.png); niri msg action screenshot-screen -p false --path \"$tmp\"; while [ ! -s \"$tmp\" ]; do sleep 0.05; done; satty --filename \"$tmp\"; rm -- \"$tmp\"'"
    }
    Alt+Print hotkey-overlay-title="Screenshot Window + Annotate" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh sh -c 'tmp=$(mktemp /tmp/screenshot.XXXXXX.png); niri msg action screenshot-window --path \"$tmp\"; while [ ! -s \"$tmp\" ]; do sleep 0.05; done; satty --filename \"$tmp\"; rm -- \"$tmp\"'"
    }
    Shift+Print hotkey-overlay-title="Screenshot OCR" {
        spawn-sh "$HOME/.config/niri/scripts/priority-run.sh $HOME/.config/niri/scripts/niri-ocr.sh"
    }


    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Shortcuts Inhibit" { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}


include "dms/cursor.kdl"
include "dms/outputs.kdl"
include "dms/windowrules.kdl"
include "dms/binds.kdl"
include "dms/layout.kdl"
include "dms/input.kdl"
include "dms/alttab.kdl"
include "dms/wpblur.kdl"

// Must be the last include — see custom-overrides.kdl for why.
include "custom-overrides.kdl"

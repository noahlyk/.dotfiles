layout {
    background-color "transparent"
    center-focused-column "never"
    default-column-display "normal"
    preset-column-widths {
        proportion 0.25
        proportion 0.50
        proportion 0.75
        proportion 1.00
    }
    default-column-width { proportion 0.50; }
    border {
        // active-color   "#cc4444"      // Softer red
        active-color   "#808080f5"      // Neutral gray
        inactive-color "#00000090"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }
    focus-ring {
        off
        active-color   "#808080f5"      // Medium gray
        inactive-color "#50505000"      // Dark gray
    }
    shadow {
        on
        softness 10
        spread 3
        offset x=0 y=0
        draw-behind-window false
        color "#00000070"
        inactive-color "#00000000"
    }
}



config-notification {
    disable-failed
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 200
        repeat-rate 70
        numlock
    }
    touchpad {
        tap
    }
    mouse {
        accel-profile "flat"
        accel-speed 0.6
    }
    warp-mouse-to-focus
    mod-key "Super"
}

workspace "mon1-7" {
    open-on-output "DP-1"
}
workspace "mon1-6" {
    open-on-output "DP-1"
}
workspace "mon1-5" {
    open-on-output "DP-1"
}
workspace "mon1-4" {
    open-on-output "DP-1"
}
workspace "mon1-3" {
    open-on-output "DP-1"
}
workspace "mon1-2" {
    open-on-output "DP-1"
}
workspace "mon1-1" {
    open-on-output "DP-1"
}
workspace "mon2-1" {
    open-on-output "DP-2"
}
workspace "mon3-2" {
    open-on-output "HDMI-A-1"
}
workspace "mon3-1" {
    open-on-output "HDMI-A-1"
}


layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}



overview {
    zoom 0.25
}

spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORMTHEME "qt6ct"
  QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
  TERMINAL "kitty"
}
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
  off
  slowdown 0.5
  workspace-switch {
    duration-ms 50
    curve "cubic-bezier" 0.16 1 0.3 1
  }
  window-open {
    duration-ms 120
    curve "cubic-bezier" 0.34 1.4 0.64 1
  }
  window-close {
    duration-ms 100
    curve "cubic-bezier" 0.33 0 0.67 0
  }
  horizontal-view-movement {
    duration-ms 50
    curve "cubic-bezier" 0.16 1 0.3 1
  }
  window-movement {
    duration-ms 120
    curve "cubic-bezier" 0.22 1 0.36 1
  }
  config-notification-open-close {
    duration-ms 100
    curve "cubic-bezier" 0.22 1 0.36 1
  }
  screenshot-ui-open {
    duration-ms 120
    curve "cubic-bezier" 0.22 1 0.36 1
  }
  overview-open-close {
    duration-ms 200
    curve "cubic-bezier" 0.34 1.2 0.64 1
  }
}

binds {
    Mod+O repeat=false { toggle-overview; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Shift+F12 {
        spawn-sh "$HOME/.config/niri/scripts/obs_ws.py replay"
    }

    // MouseRight {
    //     spawn-sh "$HOME/.config/niri/scripts/obs_ws.py toggle-recording-with-music"
    // }

    // wayscriber one-shot: no standby daemon. Home click-picks a monitor
    // (via an invisible slurp point-select) and opens the overlay there.
    // Pressing Home again closes it; pressing Home while the monitor-pick
    // is still waiting for a click cancels the pick instead of opening.
    // Once open, wayscriber grabs the keyboard itself, so undo/clear/color/
    // etc. all work via its own shortcuts (Ctrl+Z, E, Escape) with no extra
    // binds needed here. See ~/.config/niri/scripts/wayscriber-toggle.sh.
    Home { spawn-sh "$HOME/.config/niri/scripts/wayscriber-toggle.sh"; }


    Mod+T hotkey-overlay-title="Open Terminal" {
        spawn "kitty" "sh" "-c" "tmux-leap goto ~" // || tmux new -A || tmux a || tmux"
    }
    Mod+Shift+C hotkey-overlay-title="Open Odds Calculator" {
        spawn "kitty" "sh" "-c" "cd ~/code/fibsussy/odds && exec $HOME/.local/bin/uv run python launch.py"
    }
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "toggle";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "dms" "ipc" "call" "settings" "toggle";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "dms" "ipc" "call" "dankdash" "wallpaper";
    }
    Mod+D hotkey-overlay-title="Download Clipboard URL" {
        spawn-sh "$HOME/.config/niri/scripts/download.sh --temp --notify";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "dms" "ipc" "call" "notifications" "toggle";
    }
    Mod+Shift+N hotkey-overlay-title="Notepad" {
        spawn-sh "$HOME/.config/niri/scripts/focus-or-spawn-notes"
    }
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "dms" "ipc" "call" "lock" "lock";
    }
    Ctrl+Alt+Backspace hotkey-overlay-title="Power Menu" {
        spawn "dms" "ipc" "call" "powermenu" "toggle";
    }
    Ctrl+Alt+Escape hotkey-overlay-title="System Monitor (btop)" {
        spawn "kitty" "sh" "-c" "btop"
    }

    Ctrl+Alt+Delete { quit; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

    Mod+Q repeat=false { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { toggle-windowed-fullscreen; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Ctrl+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Down  { focus-window-or-monitor-down; }
    Mod+Up    { focus-window-or-monitor-up; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+H     { focus-column-or-monitor-left; }
    Mod+J     { focus-window-or-monitor-down; }
    Mod+K     { focus-window-or-monitor-up; }
    Mod+L     { focus-column-or-monitor-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next focus"; }
    Mod+Page_Up        { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev focus"; }
    Mod+U              { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next focus"; }
    Mod+I              { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev focus"; }
    Mod+Shift+Ctrl+U   { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Shift+Ctrl+I   { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }

    Mod+Shift+Page_Down { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Shift+Page_Up   { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }
    Mod+Shift+U         { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Shift+I         { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }

    Mod+WheelScrollDown      cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next focus"; }
    Mod+WheelScrollUp        cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev focus"; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh next move"; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-cycle.sh prev move"; }

    Mod+WheelScrollRight      { focus-column-right-or-first; }
    Mod+WheelScrollLeft       { focus-column-left-or-last; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right-or-first; }
    Mod+Shift+WheelScrollUp        { focus-column-left-or-last; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-1 smart"; }
    Mod+2 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon2-1 smart"; }
    Mod+3 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon3-1 smart"; }
    Mod+4 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-2"; }
    Mod+5 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-3"; }
    Mod+6 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-4"; }
    Mod+7 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-5"; }
    Mod+8 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-6"; }
    Mod+9 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon1-7"; }
    Mod+0 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh focus mon3-2"; }

    Mod+Return hotkey-overlay-title="Master Column Toggle" {
        spawn-sh "$HOME/.config/niri/scripts/niri-column-toggle.sh"
    }

    Mod+Shift+1 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-1"; }
    Mod+Shift+2 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon2-1"; }
    Mod+Shift+3 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon3-1"; }
    Mod+Shift+4 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-2"; }
    Mod+Shift+5 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-3"; }
    Mod+Shift+6 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-4"; }
    Mod+Shift+7 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-5"; }
    Mod+Shift+8 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-6"; }
    Mod+Shift+9 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon1-7"; }
    Mod+Shift+0 { spawn-sh "$HOME/.config/niri/scripts/niri-workspace-go.sh move mon3-2"; }

    Mod+Ctrl+1 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 1"; }
    Mod+Ctrl+2 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 2"; }
    Mod+Ctrl+3 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 3"; }
    Mod+Ctrl+4 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 4"; }
    Mod+Ctrl+5 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 5"; }
    Mod+Ctrl+6 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 6"; }
    Mod+Ctrl+7 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 7"; }
    Mod+Ctrl+8 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 8"; }
    Mod+Ctrl+9 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 9"; }
    Mod+Ctrl+0 { spawn-sh "$HOME/.config/niri/scripts/niri-column-move.sh 10"; }

    Mod+Ctrl+Shift+1 { move-column-to-index 1; }
    Mod+Ctrl+Shift+2 { move-column-to-index 2; }
    Mod+Ctrl+Shift+3 { move-column-to-index 3; }
    Mod+Ctrl+Shift+4 { move-column-to-index 4; }
    Mod+Ctrl+Shift+5 { move-column-to-index 5; }
    Mod+Ctrl+Shift+6 { move-column-to-index 6; }
    Mod+Ctrl+Shift+7 { move-column-to-index 7; }
    Mod+Ctrl+Shift+8 { move-column-to-index 8; }
    Mod+Ctrl+Shift+9 { move-column-to-index 9; }
    Mod+Ctrl+Shift+0 { move-column-to-index 10; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    XF86Launch1 { screenshot; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Alt+XF86Launch1 { screenshot-window; }
    Print {
        spawn-sh "tmp=$(mktemp /tmp/screenshot.XXXXXX.png); niri msg action screenshot -p false --path \"$tmp\"; while [ ! -s \"$tmp\" ]; do sleep 0.05; done; satty --filename \"$tmp\"; rm -- \"$tmp\""
    }
    Ctrl+Print {
        spawn-sh "tmp=$(mktemp /tmp/screenshot.XXXXXX.png); niri msg action screenshot-screen -p false --path \"$tmp\"; while [ ! -s \"$tmp\" ]; do sleep 0.05; done; satty --filename \"$tmp\"; rm -- \"$tmp\""
    }
    Alt+Print {
        spawn-sh "tmp=$(mktemp /tmp/screenshot.XXXXXX.png); niri msg action screenshot-window --path \"$tmp\"; while [ ! -s \"$tmp\" ]; do sleep 0.05; done; satty --filename \"$tmp\"; rm -- \"$tmp\""
    }
    Shift+Print {
        spawn-sh "$HOME/.config/niri/scripts/niri-ocr.sh"
    }


    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}


include "dms/cursor.kdl"
include "dms/outputs.kdl"
include "dms/windowrules.kdl"
include "dms/binds.kdl"
include "dms/layout.kdl"

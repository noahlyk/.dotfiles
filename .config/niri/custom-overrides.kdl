// Custom overrides — kept OUT of dms/*.kdl on purpose: those files are
// regenerated by DMS and clobber direct edits (confirmed: dms/input.kdl
// got silently rewritten back to accel-speed 0.0 within a day of editing
// it directly). niri merges same-named top-level nodes across included
// files by last-value-wins per child key, so as long as this file is the
// LAST include in config.kdl, these win over whatever DMS regenerates.

binds {
    Ctrl+Alt+Delete { quit; }
}

input {
    mouse {
        accel-speed 0.6
    }
}

// ---- App placement ---------------------------------------------------------
// open-on-workspace only affects where a window first opens; it never moves
// an already-open window. It also leaves the window UNFOCUSED when that
// workspace isn't the one you're on, so scripts/focus-on-open.sh (started
// from config.kdl) focuses firefox/keepassxc/kitty/obs once they appear.

window-rule {
    match app-id="^vesktop$"
    open-on-workspace "mon2-1"
}

window-rule {
    match app-id="^steam$"
    open-on-workspace "mon1-1"
}

window-rule {
    match app-id="^kitty$"
    exclude title="^Notes nvim$"
    open-on-workspace "mon1-2"
}

window-rule {
    match app-id="^firefox$"
    open-on-workspace "mon1-3"
}

window-rule {
    match app-id="^com\\.obsproject\\.Studio$"
    open-on-workspace "mon3-2"
}

window-rule {
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    // open-on-workspace "mon3-1"
    default-column-width { proportion 0.5; }
}

// ---- Screencast privacy ----------------------------------------------------
// Extends the KeePassXC/Secrets rule in dms/windowrules.kdl (generated, so
// not edited there).
window-rule {
    match app-id="^org\\.gnome\\.seahorse\\.Application$"
    match app-id="^Bitwarden$"
    match app-id="^com\\.bitwarden\\.desktop$"
    block-out-from "screencast"
}

// dms/cursor.kdl is regenerated, so cursor tweaks live here.
cursor {
    hide-after-inactive-ms 3000
}

// Floating windows look "lifted": thinner border + big soft drop shadow
// (tiled windows have a tight shadow that's invisible when unfocused).
// Tune: shadow softness/offset for more or less lift, border width for weight.
window-rule {
    match is-floating=true
    border { width 1; }
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=8
        color "#000000b0"
        inactive-color "#00000060"
    }
}

// gamescope-launched games (everything via `gamelaunch`) map with NO app-id, so
// they can't be matched by name. An empty `match` is true for every window and
// `exclude app-id="."` only fires on windows that have an app-id, leaving
// exactly the app-id-less ones. Same properties as the dms vrr rule.
window-rule {
    match
    exclude app-id="."
    open-fullscreen true
    variable-refresh-rate true
    geometry-corner-radius 0
    open-on-workspace "mon1-1"
}

// ---- Alt+Tab ---------------------------------------------------------------
// niri's recent-windows switcher owns Alt+Tab by default; turn it off so Alt+Tab
// reaches tmux (previous session, see tmux.conf). Lives here, not in dms/alttab.kdl,
// because DMS regenerates that file.
recent-windows {
    off
}

// Sober (native Wayland, no gamescope) has its own app-id, so the vrr/steam
// rules above never matched it. Same workspace as Steam games, plus variable
// refresh. open-fullscreen: Roblox's own fullscreen setting maps to an odd
// in-between state under niri (neither tiled nor fullscreen), so have niri
// make it a real fullscreen window when it opens. focus-on-open.sh focuses it.
window-rule {
    match app-id="^org\\.vinegarhq\\.Sober$"
    open-on-workspace "mon1-1"
    open-fullscreen true
    variable-refresh-rate true
    geometry-corner-radius 0
}

// CS2 runs native Wayland (SDL_VIDEO_DRIVER=wayland in the cs2 preset), so it
// reports its own app-id "cs2" instead of steam_app_730 and never matched the
// dms vrr rule (^steam_app_): it opened as a plain tiled window. Same
// properties as the Sober rule.
window-rule {
    match app-id="^cs2$"
    open-on-workspace "mon1-1"
    open-fullscreen true
    variable-refresh-rate true
    geometry-corner-radius 0
}

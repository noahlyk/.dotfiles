// Custom overrides — kept OUT of dms/*.kdl on purpose: those files are
// regenerated by DMS and clobber direct edits (confirmed: dms/input.kdl
// got silently rewritten back to accel-speed 0.0 within a day of editing
// it directly). niri merges same-named top-level nodes across included
// files by last-value-wins per child key, so as long as this file is the
// LAST include in config.kdl, these win over whatever DMS regenerates.

binds {
    Ctrl+Alt+Delete { quit; }
}

input {
    mouse {
        accel-speed 0.6
    }
}

// ---- App placement ---------------------------------------------------------
// open-on-workspace only affects where a window first opens; it never moves
// an already-open window. It also leaves the window UNFOCUSED when that
// workspace isn't the one you're on, so scripts/focus-on-open.sh (started
// from config.kdl) focuses firefox/keepassxc/kitty/obs once they appear.

window-rule {
    match app-id="^vesktop$"
    open-on-workspace "mon2-1"
}

window-rule {
    match app-id="^steam$"
    open-on-workspace "mon1-1"
}

window-rule {
    match app-id="^kitty$"
    exclude title="^Notes nvim$"
    open-on-workspace "mon1-2"
}

window-rule {
    match app-id="^firefox$"
    open-on-workspace "mon1-3"
}

window-rule {
    match app-id="^com\\.obsproject\\.Studio$"
    open-on-workspace "mon3-2"
}

window-rule {
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    open-on-workspace "mon3-1"
    default-column-width { proportion 0.5; }
}

// ---- Screencast privacy ----------------------------------------------------
// Extends the KeePassXC/Secrets rule in dms/windowrules.kdl (generated, so
// not edited there).
window-rule {
    match app-id="^org\\.gnome\\.seahorse\\.Application$"
    match app-id="^Bitwarden$"
    match app-id="^com\\.bitwarden\\.desktop$"
    block-out-from "screencast"
}

// dms/cursor.kdl is regenerated, so cursor tweaks live here.
cursor {
    hide-after-inactive-ms 3000
}

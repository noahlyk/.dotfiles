// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=General
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^org\\.gnome\\."
    draw-border-with-background false
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="^xdg-desktop-portal$"
}

// @id=dms_rule_5 @name=kitty
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_6 @name=firefox
window-rule {
    match app-id="firefox"
    opacity 1.00
}

// @id=dms_rule_7 @name=vrr
window-rule {
    match app-id="^gamelaunch$"
    match app-id="gamescope"
    match app-id="^steam_app_"
    open-fullscreen true
    open-on-workspace "mon1-1"
    variable-refresh-rate true
    geometry-corner-radius 0
}

// @id=dms_rule_8 @name=crosshair-overlay
window-rule {
    match app-id="crosshair-overlay"
    opacity 1.00
    border { off; }
    focus-ring { off; }
    draw-border-with-background false
}

// @id=wr_1786465372332429106 @name=Developer Tools
window-rule {
    match app-id="firefox" title="^$"
    default-column-width { proportion 0.25; }
}

// @id=wr_1786471368514405522 @name=gimp
window-rule {
    match app-id="^gimp$"
    opacity 1.00
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=dms_rule_9 @name=General
window-rule {
    match app-id="kitty" title="^Notes nvim$"
    default-column-width { proportion 0.4; }
}

// @id=dms_rule_10 @name=General
window-rule {
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    match app-id="^org\\.gnome\\.World\\.Secrets$"
    block-out-from "screencast"
}

# micproc-jack: the dedicated mic processing node (chain + parameters in
# ~/.config/pipewire/micproc.ron, hot-reloaded). Feeds the processed stream to
# the "vmic" app feed; links.rs taps the vmic monitor into the speakers.
[Unit]
Description=micproc dedicated mic processing node
After=pipewire.service
Requires=pipewire.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pw-jack %h/.config/pipewire/micproc-jack/target/release/micproc-jack
Restart=on-failure
RestartSec=3
# Explicit RT scheduling instead of relying solely on rtkit's dynamic
# promotion. `fib` is in the `audio` group, which /etc/security/limits.d
# already grants `rtprio 95` + unlimited memlock, so these should apply
# cleanly; if the unit ever fails to start with "Failed to set up special
# execution directive", drop these four lines and restart.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=88
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=pipewire.service